# Database ---------------------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, local Postgres, …).
DATABASE_URL='postgresql://user:password@host:5432/dbname?sslmode=require'

# Resend -----------------------------------------------------------------
# API key used to send magic-link sign-in emails. https://resend.com
RESEND_KEY=re_your_api_key_here
# Verified sender. Must be a domain/address verified in your Resend account.
RESEND_EMAIL_FROM="Unmyst <contact@example.com>"

# Nuxt Auth Utils --------------------------------------------------------
# Secret used to seal the session cookie. MUST be at least 32 characters.
# Generate one with: openssl rand -hex 32
NUXT_SESSION_PASSWORD=replace_with_a_random_32_char_minimum_secret

# Google OAuth (optional) — leave blank to disable Google sign-in.
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Session cookie name (optional).
NUXT_SESSION_COOKIE_NAME=unmyst_session

# Public runtime config --------------------------------------------------
# Canonical origin used for absolute URLs (canonical link, OG tags, sitemap).
# NUXT_PUBLIC_SITE_URL=https://your-domain.example
# Logo.dev publishable token (pk_…) for rendering service logos. https://logo.dev
NUXT_PUBLIC_LOGO_DEV_TOKEN=pk_your_publishable_token_here
